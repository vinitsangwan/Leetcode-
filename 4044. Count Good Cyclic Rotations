class Solution {
public:
    int countGoodRotations(vector<int>& nums) {
        int n=nums.size();
        int ct=0;
            long long  sum=0;
            long long  sum1=0;
        for(int j=0;j<n/2;j++){
            sum+=nums[j];
        }
        for(int i=n/2;i<n;i++){
            sum1+=nums[i];
        }
    for(int k=0;k<n;k++){
       if(sum1<sum){
           ct++;
       }
      long long x=nums[k];
        long long y=nums[(k+n/2)%n];
        sum=sum-x+y;
        sum1=sum1-y+x;
    }
        return ct;

        
    }
};
