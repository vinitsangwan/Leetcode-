class Solution {
public:
    bool isBalanced(string num) {
        int n=num.size();
        int sum1=0;
        int sum2=0;
        for(int i=0;i<n;i+=2){
                sum1+=num[i]-'0';
        }
             for(int j=1;j<n;j+=2){
         sum2+=num[j]-'0';
            }

        if(sum1==sum2) return true;
        else return false;
    }
};
