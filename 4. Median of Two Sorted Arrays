class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
       vector<int>vec;
       int m=nums1.size();
       int n=nums2.size();

       for(int i=0;i<m;i++){
        vec.push_back(nums1[i]);
       }
       for(int i=0;i<n;i++){
        vec.push_back(nums2[i]);
       }
     
       sort(vec.begin(),vec.end());
       int a=n+m;
       if(a%2!=0) return vec[(a+1)/2-1];
      else return (vec[a/2-1]+vec[a/2])/2.0;


    }
};
