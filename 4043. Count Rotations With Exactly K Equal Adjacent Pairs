class Solution {
public:
    int countRotations(string s, int k) {
        int n=s.size();
        int ct=0;
        int ct1=0;
        for(int j=0;j<n;j++){
            int ct=0;
            for(int i=0;i<n-1;i++){
                if(s[i]==s[i+1]){
                    ct++;
                }
            }
  if(ct==k){
      ct1++;
  }
            rotate(s.begin(),s.begin()+1,s.end()); //left rotate by 1
        }
        return ct1;
        
    }
};
