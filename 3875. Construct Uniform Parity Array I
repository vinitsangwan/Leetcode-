class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int even=0;
        for(int i=0;i<nums1.size();i++){
            if(nums1[i]%2==0){
                even++;
            }
        }
        int odd=0;
        for(int i=0;i<nums1.size();i++){
            if(nums1[i]%2!=0){
                odd++;
            }
        }
        if(nums1.size()==1){
            return true;
        }
        if(even==nums1.size()){
            return true;
        }
        else if(odd==nums1.size()){
            return true;
        }
        else if(odd==even){
            return true;
        }

        else{
            return true;
        }
    }
};
