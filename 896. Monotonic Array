class Solution {
public:
    bool isMonotonic(vector<int>& nums) {
        int ct=0;
        int ct1=0;
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i+1]>=nums[i]){
                ct++;
            }
            if(nums[i+1]<=nums[i]){
                ct1++;
            }
        }
if(ct==nums.size()-1){
    return true;
}
else if(ct1==nums.size()-1){
    return true;
}
return false;

    }
};
