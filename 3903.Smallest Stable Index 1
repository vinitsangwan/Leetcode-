class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        if(nums.size()==1 && k>=0){
            return 0;
        }
        for(int i=0;i<nums.size();i++){
            int maxi=-1;
        for(int j=0;j<=i;j++){
    maxi=max(nums[j],maxi);
        }
    int mini=INT_MAX;
    for(int j=i;j<nums.size();j++){
        mini=min(nums[j],mini);
    }
    int instable=maxi-mini;
        
    
   if(instable<=k){
        return i;
    }
        }
        return -1;
    
        }
    
};