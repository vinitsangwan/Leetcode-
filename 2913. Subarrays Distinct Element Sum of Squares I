class Solution {
public:
    int sumCounts(vector<int>& nums) {
         int ans=0;
        for(int i=0;i<nums.size();i++){
            int n=nums.size();
            set<int>st;
           
            for(int j=i;j<n;j++){
                st.insert(nums[j]);
          ans+=st.size()*st.size();
            }
        }
        return ans;
    }
};
